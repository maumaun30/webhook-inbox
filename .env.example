# Leave unset locally to use SQLite (./local.db).
# Supabase: use the transaction pooler string (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Dashboard + API password (HTTP Basic, any username). Required on Vercel.
ADMIN_TOKEN=change-me

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/keepalive.
CRON_SECRET=change-me-too

# Hooks older than this many days are deleted by the keepalive cron (0 = keep forever).
# RETENTION_DAYS=30

# Optional signature secrets, one per source: SECRET_<SOURCE>
# SECRET_SHOPIFY=
# SECRET_HUBSPOT=
# SECRET_GITHUB=
